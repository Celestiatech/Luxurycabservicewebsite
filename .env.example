## Shopify Storefront (server-side; NOT exposed to browser)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
SHOPIFY_DEFAULT_MERCHANDISE_ID=gid://shopify/ProductVariant/1234567890

## Optional (defaults to 2024-10)
SHOPIFY_API_VERSION=2024-10

## Google Maps (client-side)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
