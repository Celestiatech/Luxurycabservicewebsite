## Shopify Storefront (server-side; NOT exposed to browser)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
SHOPIFY_DEFAULT_MERCHANDISE_ID=gid://shopify/ProductVariant/1234567890
SHOPIFY_EXTRA_KM_CAR_MERCHANDISE_ID=gid://shopify/ProductVariant/44189217980515
SHOPIFY_EXTRA_KM_VAN_MERCHANDISE_ID=gid://shopify/ProductVariant/44189218013283

## Optional (defaults to 2024-10)
SHOPIFY_API_VERSION=2024-10

## Shopify OAuth install (only needed if you want "Install app" flow)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SHOPIFY_ADMIN_API_VERSION=2026-04
SHOPIFY_ADMIN_SCOPES=read_products,read_draft_orders,write_draft_orders

## Google Maps (client-side)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

## SMTP (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@smtp-brevo.com
SMTP_PASS=replace-with-brevo-smtp-key
SMTP_FROM=verified-sender@yourdomain.com

## Admin notifications
ADMIN_MAIL=admin@yourdomain.com

## Stripe Checkout
STRIPE_TEST_MODE=true
STRIPE_TEST_SECRET_KEY=replace-with-stripe-test-secret-key
NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=replace-with-stripe-test-publishable-key
STRIPE_TEST_WEBHOOK_SECRET=replace-with-stripe-test-webhook-secret
STRIPE_LIVE_SECRET_KEY=replace-with-stripe-live-secret-key
NEXT_PUBLIC_STRIPE_LIVE_PUBLISHABLE_KEY=replace-with-stripe-live-publishable-key
STRIPE_LIVE_WEBHOOK_SECRET=replace-with-stripe-live-webhook-secret
STRIPE_CURRENCY=nzd

## Optional legacy fallback names if you only want one Stripe mode configured
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

## Stripe webhook endpoint
## Local/dev: stripe listen --forward-to localhost:3000/api/stripe/webhook
## Production: https://your-domain.com/api/stripe/webhook
